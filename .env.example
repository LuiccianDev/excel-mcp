# Workspace directories allowed for reading and writing Excel spreadsheets
MCP_ALLOWED_DIRECTORIES=/path/to/spreadsheets

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Legacy tool aliases (true/false)
# When true, registers un-prefixed tool aliases alongside canonical excel_* names
EXCEL_MCP_LEGACY_ALIASES=false

# Development mode (true/false)
DEV_MODE=false
